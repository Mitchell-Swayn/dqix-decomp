+
+fn leading_object_extent(start: u32, first_mapping: u32, address: u64, size: u64) -> bool {
+    start < first_mapping && address == start as u64 && address.checked_add(size) == Some(first_mapping as u64)
+}
+
+// A mapping describes bytes at and after its address, never earlier bytes.
+// Retain the existing ARM fallback until the first mapping is reached.
+fn mapping_start(mapping_symbols: &[DisasmMode], start_addr: u32) -> (ParseMode, usize) {
+    match mapping_symbols.binary_search_by_key(&start_addr, |x| x.address) {
+        Ok(idx) => (mapping_symbols[idx].mapping, idx + 1),
+        Err(0) => (ParseMode::Arm, 0),
+        Err(idx) => (mapping_symbols[idx - 1].mapping, idx),
+    }
+}
+
+#[cfg(test)]
+mod mapping_start_tests {
+    use super::*;
+
+    #[test]
+    fn empty_and_before_first_mapping_use_arm_without_skipping_the_first_map() {
+        assert!(matches!(mapping_start(&[], 0), (ParseMode::Arm, 0)));
+        let at_zero = [DisasmMode { address: 0, mapping: ParseMode::Thumb }];
+        assert!(matches!(mapping_start(&at_zero, 0), (ParseMode::Thumb, 1)));
+        let mappings = [DisasmMode { address: 4, mapping: ParseMode::Thumb }];
+        assert!(matches!(mapping_start(&mappings, 0), (ParseMode::Arm, 0)));
+        assert!(matches!(mapping_start(&mappings, 2), (ParseMode::Arm, 0)));
+    }
+
+    #[test]
+    fn exact_leading_object_prefix_is_data_and_stops_at_the_real_code_mapping() {
+        assert!(leading_object_extent(0, 252, 0, 252));
+        assert!(!leading_object_extent(0, 252, 4, 248));
+        assert!(!leading_object_extent(0, 252, 0, 248));
+        assert!(!leading_object_extent(0, 252, 0, 256));
+        assert!(!leading_object_extent(0, 0, 0, 252));
+        assert!(!leading_object_extent(0, 252, u64::MAX, 1));
+        let mappings = [
+            DisasmMode { address: 0, mapping: ParseMode::Data },
+            DisasmMode { address: 252, mapping: ParseMode::Arm },
+        ];
+        assert!(matches!(mapping_start(&mappings, 0), (ParseMode::Data, 1)));
+        assert!(matches!(mapping_start(&mappings, 248), (ParseMode::Data, 1)));
+        assert!(matches!(mapping_start(&mappings, 252), (ParseMode::Arm, 2)));
+        assert!(matches!(mapping_start(&mappings, 256), (ParseMode::Arm, 2)));
+    }
+
+    #[test]
+    fn exact_between_and_after_mappings_keep_existing_modes_and_boundaries() {
+        let mappings = [
+            DisasmMode { address: 4, mapping: ParseMode::Thumb },
+            DisasmMode { address: 8, mapping: ParseMode::Data },
+            DisasmMode { address: 12, mapping: ParseMode::Arm },
+        ];
+        assert!(matches!(mapping_start(&mappings, 4), (ParseMode::Thumb, 1)));
+        assert!(matches!(mapping_start(&mappings, 6), (ParseMode::Thumb, 1)));
+        assert!(matches!(mapping_start(&mappings, 8), (ParseMode::Data, 2)));
+        assert!(matches!(mapping_start(&mappings, 10), (ParseMode::Data, 2)));
+        assert!(matches!(mapping_start(&mappings, 12), (ParseMode::Arm, 3)));
+        assert!(matches!(mapping_start(&mappings, 16), (ParseMode::Arm, 3)));
     }
 }
 
