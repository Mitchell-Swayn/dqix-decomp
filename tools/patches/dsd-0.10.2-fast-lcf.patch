+#[cfg(test)]
+mod fast_order_tests {
+    use super::*;
+    use ds_decomp::config::section::{SectionKind, SectionOptions};
+
+    #[test]
+    fn indexed_order_matches_original_graph_and_cycle_rejection() {
+        for seed in 0..200u32 {
+            let headers: Vec<_> = (0..3).map(|i| Section::new(SectionOptions {
+                name: format!(".s{i}"), kind: SectionKind::Data,
+                start_address: i * 4096, end_address: (i + 1) * 4096, alignment: 1, functions: None,
+            }).unwrap()).collect();
+            let mut state = seed + 1;
+            let mut random = || { state = state.wrapping_mul(1664525).wrapping_add(1013904223); state };
+            let files = (0..24).map(|i| {
+                let sections = headers.iter().filter_map(|header| {
+                    if random() % 3 == 0 { return None; }
+                    let address = if seed % 2 == 0 { i * 4 } else { random() % 24 * 4 };
+                    Some(Section::inherit(header, header.start_address() + address, header.start_address() + address + 4).unwrap())
+                }).collect();
+                DelinkFile::new(format!("file{i}"), Sections::from_sections(sections).unwrap(), false)
+            }).collect();
+            let mut delinks = Delinks::new(Sections::from_sections(headers).unwrap(), files, ModuleKind::Arm9);
+            let mut graph = Graph::<(), ()>::new();
+            for _ in &delinks.files { graph.add_node(()); }
+            for i in 0..delinks.files.len() {
+                for j in i+1..delinks.files.len() {
+                    match delinks.compare_files(&delinks.files[i], &delinks.files[j]) {
+                        Ordering::Less => { graph.add_edge(NodeIndex::new(i), NodeIndex::new(j), ()); },
+                        Ordering::Greater => { graph.add_edge(NodeIndex::new(j), NodeIndex::new(i), ()); },
+                        Ordering::Equal => {},
+                    }
+                }
+            }
+            let expected = petgraph::algo::toposort(&graph, None);
+            let actual = delinks.sort_files();
+            assert_eq!(actual.is_ok(), expected.is_ok(), "seed {seed}");
+            if let Ok(nodes) = expected {
+                let names: Vec<_> = nodes.iter().map(|n| format!("file{}", n.index())).collect();
+                assert_eq!(delinks.files.iter().map(|f| &f.name).collect::<Vec<_>>(), names.iter().collect::<Vec<_>>(), "seed {seed}");
+            }
+        }
+    }
+}
