# Auto detect text files and perform LF normalization
* text=auto

# Hash-pinned patches retain significant unified-diff context spaces.
*.patch -text whitespace=-blank-at-eol

# These build-policy inputs are verified by raw SHA-256.
/include/System/Timing.h -text
/config/usa/arm9/linker_symbols.json -text

# Accepted runtime source includes a hash-significant final blank line.
/src/RuntimeSupport/GenerateLockOwnerID.cpp -text whitespace=-blank-at-eof
/src/RuntimeSupport/MIi_UncompressBackward.cpp -text whitespace=-blank-at-eol
